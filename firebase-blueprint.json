{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles stored upon sign in / registration",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "progress": {
      "title": "Progress",
      "description": "User course progress and quiz results",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "completedLessons": { "type": "object" },
        "quizScores": { "type": "object" },
        "unlockedCertificates": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    }
  }
}
